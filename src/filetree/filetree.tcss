/* filetree — layout and modal styling.
   Per-filetype label colours are applied in tree.py (a tree label is a single
   Rich renderable), so this file handles structure, the header/footer, and the
   search overlay. */

Screen {
    background: $surface;
}

FileTree {
    padding: 0 1;
    scrollbar-size-vertical: 1;

    /* Highlight the whole row the cursor is on so it's easy to see where you
       are. The line variant spans the full width; the cursor variant gives the
       label a stronger accent when the tree is focused. */
    & > .tree--highlight-line {
        background: $primary 20%;
    }
    & > .tree--cursor {
        background: $primary 40%;
        text-style: bold;
    }
}

/* --- Search modal --- */
SearchScreen {
    align: center top;
    background: $background 60%;
}

#search-box {
    margin-top: 4;
    width: 80%;
    max-width: 120;
    height: auto;
    max-height: 80%;
    padding: 1 1 0 1;
    background: $panel;
    border: round $primary;
}

#search-input {
    border: none;
    background: $boost;
}

#search-note {
    color: $text-muted;
    padding: 0 1;
    height: 1;
}

#search-results {
    height: auto;
    max-height: 20;
    border: none;
    background: transparent;
}

#search-results:focus {
    border: none;
}

/* --- Markdown preview modal --- */
MarkdownScreen {
    align: center middle;
    background: $background 60%;
}

#md-box {
    width: 90%;
    max-width: 110;
    height: 90%;
    padding: 0 1;
    background: $panel;
    border: round $primary;
}

#md-title {
    height: 1;
    width: 100%;
    padding: 0 1;
    color: $text-muted;
    text-overflow: ellipsis;
}

#md-viewer {
    height: 1fr;
    background: transparent;
    scrollbar-size-vertical: 1;
}

#md-viewer Markdown {
    background: transparent;
}

/* The contents pane docks left over the document, so it needs its own
   background and an edge to read as a sidebar. */
#md-viewer MarkdownTableOfContents {
    background: $boost;
    border-right: solid $primary 40%;
}

#md-viewer MarkdownTableOfContents > Tree {
    background: transparent;
    padding: 0 1;
}

#md-hint {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}
